        'migrant': [
            { icon: 'bi-globe', text: '정착 지원 서비스' },
            { icon: 'bi-book', text: '언어 및 문화 교육' },
            { icon: 'bi-hand-thumbs-up', text: '취업 연계 프로그램' }
        ],
        'asset': [
            { icon: 'bi-graph-up-arrow', text: '희망키움통장' },
            { icon: 'bi-safe', text: '내일키움통장' },
            { icon: 'bi-coin', text: '목돈 마련 플랜' }
        ]
    };

    function changeTab(type, element) {
        // 1. 모든 메뉴의 하이라이트 제거 후 클릭된 것만 추가
        const links = document.querySelectorAll('.tab-link');
        links.forEach(link => link.classList.remove('active'));
        element.classList.add('active');

        // 2. 콘텐츠 변경
        const contentArea = document.getElementById('tabContent');
        const data = tabData[type];
        
        let html = '';
        data.forEach(item => {
            html += `
                <div class="service-card fade-in">
                    <i class="bi ${item.icon}"></i>
                    <span>${item.text}</span>
                </div>
            `;
        });
        
        contentArea.innerHTML = html;
    }
</script>
