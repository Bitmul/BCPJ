@charset "UTF-8";

@import
	url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap')
	;

body {
	font-family: 'Noto Sans KR', sans-serif;
	background-color: #f8f9fa;
	color: #333;
}

/* 부천나눔 커스텀 블루 컬러 */
.bg-primary-bcn {
	background-color: #4facfe !important;
}

.text-primary-bcn {
	color: #0056b3 !important;
}

.btn-primary-bcn {
	background-color: #0056b3;
	border-color: #0056b3;
	color: white;
	transition: all 0.3s;
}

.btn-primary-bcn:hover {
	background-color: #004494;
	border-color: #004494;
	color: white;
	transform: translateY(-2px);
}

.hero-section {
	background-color: white;
	padding: 0px 0;
	border-bottom: 1px solid #eee;
}

.hero-title {
	font-size: 3rem;
	font-weight: 700;
	margin-bottom: 20px;
}

.hero-subtitle {
	font-size: 1.25rem;
	font-weight: 300;
	color: #666;
	margin-bottom: 40px;
	line-height: 1.8;
}

.feature-card {
	border: none;
	border-radius: 15px;
	transition: box-shadow 0.3s;
}

.feature-card:hover {
	box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
}

.footer {
	background-color: #343a40;
	color: #bbb;
	padding: 50px 0;
	padding-top: 40px 0;
	margin-top: 80px;
}

.bcn-table-container {
	background: white;
	border-radius: 15px;
	padding: 30px;
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.table thead th {
	border-top: none;
	background-color: #f8f9fa;
	color: #0056b3;
	font-weight: 600;
	text-transform: uppercase;
	font-size: 0.9rem;
}

.btn-action {
	border-radius: 8px;
	padding: 8px 20px;
	font-weight: 500;
	transition: 0.3s;
}

.form-card {
	border: none;
	border-radius: 20px;
	overflow: hidden;
}

.form-card .card-header {
	background-color: white;
	border-bottom: 2px solid #f1f1f1;
	padding: 25px;
}

.form-label {
	font-weight: 600;
	color: #555;
	margin-bottom: 10px;
}

.form-control {
	border-radius: 10px;
	padding: 12px;
	border: 1px solid #ddd;
}

.form-control:focus {
	border-color: #0056b3;
	box-shadow: 0 0 0 0.25rem rgba(0, 86, 179, 0.1);
}

.main-slider {
	width: 100%;
	overflow: hidden;
}

.carousel-item {
	height: 500px;
	background-color: #0056b3;
}

.carousel-item img {
	object-fit: cover;
	height: 100%;
	filter: brightness(0.7);
}

.carousel-caption {
	bottom: 30%;
	z-index: 10;
}

.carousel-caption h2 {
	font-size: 3rem;
	font-weight: 700;
	text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.carousel-control-prev-icon, .carousel-control-next-icon {
	width: 3rem;
	height: 3rem;
}

.logo-img {
	height: 40px;
	width: auto;
	transform: translateY(-3px);
	transition: transform 0.3s ease;
}

.navbar-brand:hover .logo-img {
	transform: translateY(-3px) scale(1.1);
}

.navbar-brand span {
	font-size: 1.25rem;
	letter-spacing: -0.5px;
}

.sub-menu-bar {
	background-color: white;
	border-bottom: 1px solid #e9ecef;
	position: sticky;
	top: 66px;
	z-index: 1000;
}

.nav-menu-list {
	display: flex;
	justify-content: space-between;
	list-style: none;
	margin: 0;
	padding: 0;
}

.nav-item-main {
	position: relative;
	flex: 1;
	text-align: center;
}

.nav-link-main {
	display: block;
	padding: 15px 0;
	color: #333;
	font-weight: 500;
	text-decoration: none;
	transition: color 0.3s, background-color 0.3s;
}

.nav-link-main:hover {
	color: #0056b3;
	background-color: #f8f9fa;
}

.dropdown-custom {
	display: none;
	position: absolute;
	top: 100%;
	left: 0;
	width: 100%;
	background-color: white;
	box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
	list-style: none;
	padding: 10px 0;
	border-top: 2px solid #0056b3;
	z-index: 1001;
}

.dropdown-custom li a {
	display: block;
	padding: 8px 15px;
	color: #666;
	text-decoration: none;
	font-size: 0.9rem;
	transition: all 0.2s;
}

.dropdown-custom li a:hover {
	background-color: #f1f4f9;
	color: #0056b3;
	padding-left: 20px;
}

.nav-item-main:hover .dropdown-custom {
	display: block;
	animation: fadeInDown 0.3s ease;
}

@
keyframes fadeInDown {from { opacity:0;
	transform: translateY(-10px);
}

to {
	opacity: 1;
	transform: translateY(0);
}

}

/* 배너 섹션 컨테이너 */
.info-banner-section {
	width: 1000px;
	height: 200px;
	margin: 30px auto;
	background: linear-gradient(rgba(0, 86, 179, 0.8), rgba(0, 86, 179, 0.8)),
		url('https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=2029')
		no-repeat center center;
	background-size: cover;
	border-radius: 15px;
	display: flex;
	align-items: center;
	color: white;
	padding: 0 40px;
	box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
	background: linear-gradient(rgba(0, 86, 179, 0.8), rgba(0, 86, 179, 0.8)),
		url('https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=2029')
		no-repeat center center;
}

/* 왼쪽 연락처 영역 */
.banner-contact {
	flex: 1.5;
	display: flex;
	justify-content: flex-start;
	gap: 60px;
	border-right: 1px solid rgba(255, 255, 255, 0.2);
	padding-right: 40px;
}

.contact-item {
	margin-bottom: 15px;
}

.contact-label {
	font-size: 1.2rem;
	font-weight: 700;
	background: rgba(255, 255, 255, 0.2);
	padding: 3px 10px;
	color: #fff;
	border-radius: 20px;
	margin-right: 10px;
	margin: 0;
}

.contact-number {
	font-size: 1.4rem;
	font-weight: 500;
	text-align: left;
	color: #fff;
	letter-spacing: 1px;
	line-height: 1;
}

/* 오른쪽 공지사항 영역 */
.banner-notice {
	flex: 1;
	padding-left: 40px;
}

.contact-group {
	display: flex;
	flex-direction: column;
	gap: 10px;
}

.info-banner-section {
	background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
		url('../images/banner-bg.webp') no-repeat center center;
	background-size: cover;
}

.notice-title-box {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 15px;
}

.notice-title-box h5 {
	margin: 0;
	font-weight: 700;
	font-size: 1.1rem;
}

.notice-content-list {
	list-style: none;
	padding: 0;
	margin: 0;
}

.notice-item {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	margin-bottom: 8px;
	font-size: 0.95rem;
}

.notice-item a {
	color: white;
	text-decoration: none;
	transition: opacity 0.3s;
}

.notice-item a:hover {
	text-decoration: underline;
	opacity: 0.8;
}
/* 5등분 메뉴 섹션 */
.quick-menu-section {
	width: 970px;
	margin: 20px auto;
	display: flex;
	gap: 10px;
}

.quick-menu-item {
	flex: 1;
	height: 100px;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	background-color: #1e88e5;
	border: 1px solid #e9ecef;
	border-radius: 12px;
	text-decoration: none;
	color: #333;
	transition: all 0.3s ease;
	box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
}

.quick-menu-item:hover {
	background-color: #0056b3;
	color: white;
	transform: translateY(-5px);
	box-shadow: 0 8px 15px rgba(0, 86, 179, 0.2);
	border-color: #0056b3;
}

.quick-menu-icon {
	font-size: 1.8rem;
	margin-bottom: 8px;
}

.quick-menu-text {
	font-size: 1rem;
	font-weight: 600;
}

/* 대상자별 서비스 섹션 */
.service-tab-section {
	width: 970px;
	margin: 40px auto;
}

.service-title {
	font-size: 1.5rem;
	font-weight: 700;
	text-align: left;
	color: #333;
	padding-bottom: 10px;
	border-bottom: 2px solid #c5c5c5;
	margin-bottom: 20px;
}

.tab-container {
	display: flex;
	gap: 30px;
	min-height: 250px;
}

/* 왼쪽 메뉴 스타일 */
.tab-menu {
	flex: 1;
	list-style: none;
	padding: 0;
	margin: 0;
}

.tab-link {
	display: block;
	padding: 12px 20px;
	color: #666;
	text-decoration: none;
	font-weight: 500;
	border-radius: 30px;
	margin-bottom: 5px;
	transition: all 0.3s ease;
	cursor: pointer;
}

.tab-link:hover {
	color: #000;
	background-color: #f8f9fa;
}

.tab-link.active {
	background-color: #0056b3;
	color: white !important;
}

/* 오른쪽 콘텐츠 영역 */
.tab-content-area {
	flex: 3;
	display: flex;
	gap: 10px;
}

.service-card {
	flex: 1;
	background-color: #4facfe;
	color: white;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	padding: 20px;
	text-align: center;
	border-radius: 5px;
	transition: transform 0.3s;
}

.service-card:nth-child(2) {
	background-color: #3895d3;
}

.service-card:nth-child(3) {
	background-color: #2b7bb9;
}

.service-card i {
	font-size: 2.5rem;
	margin-bottom: 15px;
}

.service-card span {
	font-size: 1rem;
	font-weight: 500;
	line-height: 1.4;
}

.fade-in {
	animation: fadeIn 0.5s ease;
}

@
keyframes fadeIn {from { opacity:0;
	transform: translateY(5px);
}

to {
	opacity: 1;
	transform: translateY(0);
}

}
/* 매장 안내 섹션 (전체 화면 배경) */
.location-section {
	width: 100%;
	height: 600px;
	background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
		url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=2070')
		no-repeat center center;
	background-size: cover;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-top: 50px;
	margin-bottom: 50px;
}

.location-container {
	width: 1100px;
	display: flex;
	gap: 30px;
	justify-content: space-between;
}

.location-card {
	flex: 1;
	height: 350px;
	position: relative;
	border-radius: 10px;
	overflow: hidden;
	box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
	transition: transform 0.3s ease;
}

.location-card:hover {
	transform: translateY(-10px);
}

.card-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-size: cover;
	background-position: center;
	filter: brightness(0.6);
	z-index: 1;
}

.card-content {
	position: relative;
	z-index: 2;
	color: white;
	padding: 30px;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: center;
}

.card-title {
	font-size: 1.6rem;
	font-weight: 700;
	margin-bottom: 20px;
	border-bottom: 2px solid rgba(255, 255, 255, 0.3);
	padding-bottom: 10px;
}

.card-info {
	font-size: 0.95rem;
	line-height: 1.8;
	margin: 0;
}

.top-wide-banner {
	width: 100%;
	height: 230px;
	background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
		url('https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=2070')
		no-repeat center center;
	background-size: cover;
	display: flex;
	align-items: center;
	justify-content: center;
	color: white;
	text-align: center;
}

.banner-text-box h2 {
	font-size: 2.2rem;
	font-weight: 700;
	margin-bottom: 8px;
	letter-spacing: -0.5px;
	text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.banner-text-box p {
	font-size: 1.1rem;
	margin: 0;
	opacity: 0.9;
	text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
}

.sub-tab-section {
	width: 100%;
	max-width: 1100px;
	margin: 30px auto;
	padding: 0 15px;
}

.sub-tab-wrapper {
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 15px;
	list-style: none;
	padding: 0 0 20px 0;
	margin: 0;
	border-bottom: 1px solid #f1f1f1;
}

.sub-tab-link {
	display: inline-block;
	padding: 10px 22px;
	color: #666;
	font-size: 1.05rem;
	font-weight: 600;
	text-decoration: none;
	border-radius: 30px;
	transition: all 0.25s ease;
}

.sub-tab-link:hover {
	color: #333;
	background-color: #f5f5f5;
}

.sub-tab-link.active {
	background-color: #1e88e5;
	color: white !important;
	box-shadow: 0 4px 10px rgba(30, 136, 229, 0.2);
}

.greet-banner {
	width: 100%;
	height: 230px;
	display: flex;
	align-items: center;
	justify-content: center;
	color: white;
	text-align: center;
	margin: 40px auto;
}

.greet-banner-background {
	background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
		url('https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=2070')
		no-repeat center center;
	background-size: cover;
}